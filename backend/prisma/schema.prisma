generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String         @id @default(cuid())
  name                    String
  email                   String         @unique
  phone                   String
  role                    UserRole
  password                String
  avatar                  String?
  status                  AccountStatus  @default(ACTIVE)
  address                 String?
  pincode                 String?
  referralCode            String?
  referredBy              String?
  referralsCount          Int            @default(0)
  referralDiscountBalance Float          @default(0)
  referralBonusEarned     Float          @default(0)
  providerId              String?
  verificationCode        String?
  profileComplete         Boolean        @default(false)
  resetToken              String?
  resetTokenExpiry        DateTime?

  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  latitude                Float?
  longitude               Float?

  // Indexes for common queries
  @@index([role])
  @@index([status])
  @@index([email])
  @@index([providerId])
  @@index([createdAt])

  authEvents              AuthEvent[]
  bookingsAsCustomer      Booking[]      @relation("CustomerBookings")
  notifications           Notification[]
  providerProfile         Provider?
  customerProfile         Customer?
  reviews                 Review[]       @relation("ReviewerReviews")
  savedPros               SavedPro[]
  leadsAsCustomer         Lead[]
  serviceRequests         PermanentServiceRequest[] @relation("CustomerServiceRequests")
  wallet                  Wallet?
  walletTransactions      WalletTransaction[]
  walletWithdrawalRequests WalletWithdrawalRequest[]
  platformFeeAccount      PlatformFeeAccount?
  platformFeePayments     PlatformFeePayment[]
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  address   String
  pincode   String
  preferences Json    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  title            String
  message          String
  type             String   @default("SYSTEM")
  isRead           Boolean  @default(false)
  relatedBookingId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Indexes for common queries
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  @@index([userId, isRead])

  user      User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id               String       @id @default(cuid())
  userId           String?
  requesterName    String
  requesterEmail   String
  subject          String
  message          String
  status           TicketStatus @default(OPEN)
  adminResponse    String?
  relatedBookingId String?
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Indexes for common queries
  @@index([status])
  @@index([requesterEmail])
  @@index([userId])
  @@index([createdAt])
}

model AuthEvent {
  id        String        @id @default(cuid())
  userId    String?
  email     String
  eventType AuthEventType
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())
  user      User?         @relation(fields: [userId], references: [id])
}

model Provider {
  id                String    @id @default(cuid())
  userId            String    @unique
  category          String
  rating            Float     @default(0)
  reviewCount       Int       @default(0)
  verificationLevel VerificationLevel @default(BRONZE)
  accountStatus     ProviderAccountStatus @default(ACTIVE)
  profileComplete   Boolean   @default(false)

  experienceYears   Int       @default(3)
  jobsCompleted     Int       @default(0)
  serviceFee        Float     @default(0)
  bio               String?
  specialties       Json      @default("[]")
  serviceAreas      Json      @default("[]")
  photo             String?
  serviceInterested String?
  isVerified        Boolean   @default(false)
  isFeatured        Boolean   @default(false)

  // ServeGo Business Model — permanent provider level & sector (independent of subscription)
  providerLevel     ProviderLevel @default(BRONZE)
  promotionDate     DateTime?
  sector            ProviderSector @default(GENERAL)
  latitude          Float?
  longitude         Float?
  maxRadiusKm       Float?                 // custom service radius; falls back to the admin default
  isOnline          Boolean       @default(true)
  acceptingBookings Boolean       @default(true)

  availableDays     Json      @default("[]")
  timeSlots         Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Indexes for common queries
  @@index([userId])
  @@index([category])
  @@index([rating])
  @@index([isVerified])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([accountStatus])

  bookings          Booking[]
  user              User      @relation(fields: [userId], references: [id])
  reviews           Review[]  @relation("ProviderReviews")
  badges            ProviderBadge[]
  savedByCustomers  SavedPro[]

  providerServices        ProviderService[]
  providerServiceRequests ProviderServiceRequest[]
  availabilitySlots       AvailabilitySlot[]
  subscription            ProviderSubscription?
  subscriptionTransactions SubscriptionTransaction[]
  leads                   Lead[]                    @relation("CurrentLeadProvider")
  leadAssignments         LeadAssignmentHistory[]
  leadTransfersFrom       LeadTransferHistory[]     @relation("TransferFrom")
  leadTransfersTo         LeadTransferHistory[]     @relation("TransferTo")
  promotionHistory        PromotionHistory[]
  levelHistory            ProviderLevelHistory[]
  performance             ProviderPerformance?
  rankingMetrics          RankingMetrics?
  locationUpdates         BookingLocationUpdate[]
  permanentServiceAssignments PermanentServiceRequest[] @relation("PermanentServiceAssignments")
  walletWithdrawalRequests WalletWithdrawalRequest[]
}

model ProviderBadge {
  id         String    @id @default(cuid())
  providerId String
  badgeType  BadgeType
  awardedAt  DateTime  @default(now())

  provider   Provider  @relation(fields: [providerId], references: [id])

  @@unique([providerId, badgeType])
}

model Service {
  id             String         @id @default(cuid())
  name           String
  nameNormalized String?        @unique
  description    String?

  popularIssues  Json           @default("[]")
  isHidden       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  bookings       Booking[]
  providerServices ProviderService[]
}

// Provider’s approved global services
model ProviderService {
  id          String   @id @default(cuid())
  providerId  String
  serviceId   String
  description String?
  providerServiceRequestId String? // if this link was created from an approval request
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider          Provider @relation(fields: [providerId], references: [id])
  service           Service  @relation(fields: [serviceId], references: [id])

  providerServiceRequests ProviderServiceRequest[]

  @@unique([providerId, serviceId])
  @@unique([providerServiceRequestId])
  @@index([providerId])
  @@index([serviceId])
}

// Provider’s pending/denied service registration request
model ProviderServiceRequest {
  id                    String        @id @default(cuid())
  providerId            String
  requestedServiceName String
  /// The Service that this request was created/approved against.
  /// Backfilled from requestedServiceName.
  requestedServiceId   String?
  description           String
  popularIssues        Json          @default("[]")
  experienceYears      Int?
  status                ApprovalStatus @default(PENDING)
  denialReason         String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  provider              Provider @relation(fields: [providerId], references: [id])
  providerServices     ProviderService[]

  @@index([status, createdAt])
}


model Booking {
  id              String        @id @default(cuid())
  customerId      String
  providerId      String
  serviceId       String?
  serviceCategory String
  bookingDate     DateTime      @default(now())
  status          BookingStatus @default(PENDING)
  locationAddress String
  city            String
  instructions    String?

  // Customer's exact service location picked on the map at booking time.
  // Authoritative for provider radius matching and tracking (endLocation is a
  // JSON mirror kept for dispatch payloads).
  serviceLatitude  Float?
  serviceLongitude Float?

  startedAt       DateTime?     // when the provider started work (CONFIRMED → ONGOING)
  completedAt     DateTime?     // when the job was completed (→ COMPLETED)

  cancelledBy     String?
  cancelledReason String?
  amount          Float?

  // Platform charge breakdown (admin-configurable, separate customer/provider rates).
  // amount = base service cost. customerPlatformCharge is added on top for the
  // customer's bill (totalAmount). providerPlatformCharge is the provider's
  // commission on the base amount (providerPayout = amount - providerPlatformCharge).
  customerPlatformCharge Float   @default(0)
  providerPlatformCharge Float   @default(0)
  totalAmount            Float?
  providerPayout         Float?

  messages        Json          @default("[]")
  reviewed        Boolean       @default(false)
  statusHistory   Json          @default("[]")

  // Real-time location tracking.
  // startLocation = where the provider began the trip (dispatch point).
  // endLocation = the customer's service location (used for ETA + progress).
  startLocation         Json?
  endLocation           Json?
  providerLatitude      Float?
  providerLongitude     Float?
  providerLocationUpdatedAt DateTime?

  // Dispatch lifecycle phase driven by the provider: null → ON_THE_WAY → ARRIVED.
  // Independent of the booking state machine so tracking UX stays decoupled from
  // the CONFIRMED/ONGOING/COMPLETED status flow.
  providerPhase         String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Indexes for common queries
  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([bookingDate])
  @@index([serviceCategory])
  @@index([createdAt])
  @@index([customerId, status])
  @@index([providerId, status])

  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  provider        Provider      @relation(fields: [providerId], references: [id])
  service         Service?      @relation(fields: [serviceId], references: [id])
  reviews         Review[]
  events          BookingEvent[]
  locationUpdates BookingLocationUpdate[]
  lead            Lead?
  cancellationReasons CancellationReason[]
}

// Bounded history of provider location pings for a booking. Kept for
// telemetry/audit and ETA verification; pruned after the configured retention
// window (locationHistoryClearanceHours) once the booking is closed.
model BookingLocationUpdate {
  id         String   @id @default(cuid())
  bookingId  String
  providerId String
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([bookingId])
  @@index([providerId])
  @@index([recordedAt])
}

model BookingEvent {
  id         String   @id @default(cuid())
  bookingId  String
  actorRole  String
  actorId    String?
  action     String
  note       String?
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([createdAt])
}

model Review {
  id              String   @id @default(cuid())
  reviewerId      String
  reviewerName    String?
  providerId      String
  bookingId       String?
  rating          Float
  comment         String?
  date            DateTime @default(now())
  serviceCategory String?
  createdAt       DateTime @default(now())
  booking         Booking? @relation(fields: [bookingId], references: [id])
  provider        Provider @relation("ProviderReviews", fields: [providerId], references: [id])
  reviewer        User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  @@unique([bookingId])
  @@index([providerId, createdAt])
  @@index([reviewerId])
}

enum UserRole {
  customer
  provider
  admin
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ON_HOLD
  BLOCKED
}

enum AuthEventType {
  SIGNUP
  LOGIN
  LOGOUT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  REJECTED
}

enum VerificationLevel {
  BRONZE
  SILVER
  GOLD
  ELITE
}

enum ProviderAccountStatus {
  ACTIVE
  ON_HOLD
  BLOCKED
}

model AvailabilitySlot {
  id         String   @id @default(cuid())
  providerId String
  dayOfWeek  String
  startTime  String
  endTime    String

  provider   Provider @relation(fields: [providerId], references: [id])

  @@unique([providerId, dayOfWeek, startTime])
  @@index([providerId])
}

model SavedPro {
  id         String   @id @default(cuid())
  customerId String
  providerId String
  createdAt  DateTime @default(now())

  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([customerId, providerId])
  @@index([customerId])
  @@index([providerId])
}

enum BadgeType {
  TOP_RATED
  FAST_RESPONSE
  JOBS_100
  RELIABLE_PROVIDER
  MULTI_SERVICE_EXPERT
  CUSTOMER_FAVORITE
  ELITE_PROVIDER
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  oldValue   Json?
  newValue   Json?
  ip         String?
  createdAt  DateTime @default(now())
}

// ============================================================
// ServeGo Business Model — Provider Levels, Subscriptions, Leads
// ============================================================

// Permanent promotion rules per provider level. Admin-configurable.
model ProviderLevelRule {
  id              String        @id @default(cuid())
  level           ProviderLevel @unique
  minJobs         Int
  discountPercent Float         @default(0)
  description     String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([minJobs])
}

// Admin-configurable subscription packages. Level 0 = one free lead (price 0).
model SubscriptionPlan {
  id          String          @id @default(cuid())
  level       Int             @unique
  name        String
  price       Float           @default(0)
  leadCount   Int             @default(3)
  sector      ProviderSector  @default(GENERAL)
  isFree      Boolean         @default(false)
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions      ProviderSubscription[]
  transactions       SubscriptionTransaction[]

  @@index([active])
}

// Current subscription state — exactly one row per provider.
// `status` tracks the payment lifecycle; effective "Active" (for lead
// eligibility) is computed from provider + subscription state (see
// subscriptionService.subscriptionIsActive).
model ProviderSubscription {
  id                               String                    @id @default(cuid())
  providerId                       String                    @unique
  level                            Int                       @default(0)
  status                           SubscriptionStatus        @default(ACTIVE)
  remainingLeads                   Int                       @default(1)
  leadCount                        Int                       @default(0)
  completedJobsCurrentSubscription Int                       @default(0)
  sector                           ProviderSector            @default(GENERAL)
  planId                           String?
  freeLeadUsed                     Boolean                   @default(false)

  // Snapshot of the last successful purchase (mirrors SubscriptionTransaction).
  price                            Float                     @default(0)
  discountAmount                   Float                     @default(0)
  finalAmount                      Float                     @default(0)
  paymentStatus                    SubscriptionPaymentStatus @default(PENDING)
  paymentMethod                    String?
  paymentGateway                   String?
  transactionId                    String?
  invoiceNumber                    String?

  lastPurchaseAt                   DateTime?
  activatedAt                      DateTime?
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @updatedAt

  provider     Provider                @relation(fields: [providerId], references: [id])
  plan         SubscriptionPlan?       @relation(fields: [planId], references: [id])
  transactions SubscriptionTransaction[]
}

// Purchase history for every subscription level (including the free lead grant).
model SubscriptionTransaction {
  id              String                    @id @default(cuid())
  providerId      String
  subscriptionId  String?
  planId          String?
  levelPurchased  Int
  planName        String?
  price           Float                     @default(0)
  discountPercent Float                     @default(0)
  discountAmount  Float                     @default(0)
  finalAmount     Float                     @default(0)
  leadCount       Int                       @default(0)
  paymentStatus   SubscriptionPaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentGateway  String?
  transactionId   String?
  gatewayOrderId  String?
  gatewayPaymentId String?
  invoiceNumber   String?
  errorDetail     String?
  purchasedAt     DateTime                  @default(now())

  provider     Provider             @relation(fields: [providerId], references: [id])
  subscription ProviderSubscription? @relation(fields: [subscriptionId], references: [id])
  plan         SubscriptionPlan?     @relation(fields: [planId], references: [id])

  @@index([providerId])
  @@index([purchasedAt])
  @@index([gatewayOrderId])
}

// Monthly platform fee — one billing account per user (provider or customer).
// Providers MUST keep this fee paid to receive new leads; customers are only
// reminded and are never blocked from the platform.
model PlatformFeeAccount {
  id             String             @id @default(cuid())
  userId         String             @unique
  role           PlatformFeeRole    @default(PROVIDER)

  // Billing window. Providers get `platformFeeGraceDays` from join before the
  // first payment is due; every successful payment advances `periodEnd` by one
  // month. When `now > periodEnd` the account is OVERDUE.
  periodStart    DateTime?
  periodEnd      DateTime?
  graceEndsAt    DateTime?
  status         PlatformFeeStatus  @default(ACTIVE)
  amount         Float              @default(0)
  lastPaymentAt  DateTime?
  lastReminderAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user     User                @relation(fields: [userId], references: [id])
  payments PlatformFeePayment[]

  @@index([role])
  @@index([status])
  @@index([periodEnd])
  @@index([userId])
}

// Payment history for the monthly platform fee (PENDING → PAID/FAILED, and
// REFUNDED via the gateway webhook).
model PlatformFeePayment {
  id               String                 @id @default(cuid())
  accountId        String?
  userId           String
  role             PlatformFeeRole        @default(PROVIDER)
  periodStart      DateTime?
  periodEnd        DateTime?
  amount           Float                  @default(0)
  paymentStatus    PlatformFeePaymentStatus @default(PENDING)
  paymentMethod    String?
  paymentGateway   String?
  transactionId    String?
  gatewayOrderId   String?
  gatewayPaymentId String?
  invoiceNumber    String?
  errorDetail      String?
  paidAt           DateTime?
  createdAt        DateTime               @default(now())

  account PlatformFeeAccount? @relation(fields: [accountId], references: [id])
  user    User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([gatewayOrderId])
  @@index([paymentStatus])
  @@index([createdAt])
}

// A booking's lead lifecycle — created when the customer books.
model Lead {
  id               String     @id @default(cuid())
  bookingId        String?    @unique
  customerId       String
  providerId       String?
  serviceId        String?
  serviceCategory  String
  status           LeadStatus @default(NEW)
  distanceKm       Float?
  notes            String?
  expiryTime       DateTime?
  viewedAt         DateTime?
  acceptedAt       DateTime?
  completedAt      DateTime?
  rejectedAt       DateTime?
  transferCount    Int        @default(0)
  lastRejectReason String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Leads no longer auto-expire on a timer. `expiryTime` is the moment the
  // lead has waited the fixed 24-hour response window without being accepted;
  // when it elapses the admin is alerted and `adminAlertedAt` is set
  // (guards against duplicate alerts). The lead stays open until accepted,
  // rejected by all eligible providers, or otherwise settled.
  adminAlertedAt    DateTime?

  booking            Booking?                @relation(fields: [bookingId], references: [id])
  customer           User                    @relation(fields: [customerId], references: [id])
  provider           Provider?               @relation("CurrentLeadProvider", fields: [providerId], references: [id])
  assignmentHistory  LeadAssignmentHistory[]
  transferHistory    LeadTransferHistory[]
  cancellationReasons CancellationReason[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([expiryTime])
  @@index([createdAt])
}

model LeadAssignmentHistory {
  id         String     @id @default(cuid())
  leadId     String
  providerId String
  status     LeadStatus @default(NEW)
  isCurrent  Boolean    @default(false)
  assignedAt DateTime   @default(now())
  actionAt   DateTime?
  reason     String?

  lead     Lead     @relation(fields: [leadId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([leadId])
  @@index([providerId])
}

model LeadTransferHistory {
  id             String   @id @default(cuid())
  leadId         String
  fromProviderId String?
  toProviderId   String?
  reason         String   @default("REJECTED")
  details        Json?
  transferredAt  DateTime @default(now())

  lead         Lead      @relation(fields: [leadId], references: [id])
  fromProvider Provider? @relation("TransferFrom", fields: [fromProviderId], references: [id])
  toProvider   Provider? @relation("TransferTo", fields: [toProviderId], references: [id])

  @@index([leadId])
}

// Promotion celebration records — one per level-up.
model PromotionHistory {
  id                       String       @id @default(cuid())
  providerId               String
  fromLevel                ProviderLevel
  toLevel                  ProviderLevel
  completedJobsAtPromotion Int
  promotedAt               DateTime     @default(now())
  acknowledged             Boolean      @default(false)
  acknowledgedAt           DateTime?

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([promotedAt])
}

// Full ledger of provider level changes.
model ProviderLevelHistory {
  id            String        @id @default(cuid())
  providerId    String
  level         ProviderLevel
  previousLevel ProviderLevel?
  reason        String        @default("INITIAL")
  completedJobs Int
  changedAt     DateTime      @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@index([changedAt])
}

// Permanent / contract service requests — customer submits details, admin
// reviews and assigns a provider (no direct customer-provider interaction).
model PermanentServiceRequest {
  id                     String                     @id @default(cuid())
  customerId             String
  serviceCategory        String
  engagementType         PermanentEngagementType     @default(CONTRACT)
  startDate              DateTime
  contractDurationYears  Int?
  contractDurationDays   Int?
  monthlyBudget          Float
  additionalInfo         String?
  status                 PermanentRequestStatus      @default(PENDING)
  assignedProviderId     String?
  adminNote              String?

  // Service location picked on the map by the customer (mandatory at submit).
  locationAddress   String?
  serviceLatitude   Float?
  serviceLongitude  Float?

  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([serviceCategory])

  customer         User     @relation("CustomerServiceRequests", fields: [customerId], references: [id])
  assignedProvider Provider? @relation("PermanentServiceAssignments", fields: [assignedProviderId], references: [id])
}

enum PermanentEngagementType {
  PERMANENT
  CONTRACT
}

enum PermanentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Live performance metrics used for ranking + cooldown penalties.
model ProviderPerformance {
  id                    String    @id @default(cuid())
  providerId            String    @unique
  totalLeads            Int       @default(0)
  acceptedLeads         Int       @default(0)
  rejectedLeads         Int       @default(0)
  ignoredLeads          Int       @default(0)
  expiredLeads          Int       @default(0)
  completedJobs         Int       @default(0)
  cancelledJobs         Int       @default(0)
  jobsStarted           Int       @default(0)
  acceptanceRate        Float     @default(0)
  responseRate          Float     @default(0)
  cancellationRate      Float     @default(0)
  averageResponseTimeMs Float     @default(0)
  averageJobCompletionTimeMs Float @default(0)
  lateArrivalCount      Int       @default(0)
  lateArrivalRate       Float     @default(0)
  penaltyScore          Int       @default(0)
  totalEarnings         Float     @default(0)
  totalCommission       Float     @default(0)
  cooldownUntil         DateTime?
  cooldownCount         Int       @default(0)
  updatedAt             DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
}

// Precomputed snapshot used by the provider ranking algorithm.
model RankingMetrics {
  id               String        @id @default(cuid())
  providerId       String        @unique
  rankScore        Float         @default(0)
  distanceKm       Float?
  rating           Float         @default(0)
  acceptanceRate   Float         @default(0)
  responseRate     Float         @default(0)
  cancellationRate Float         @default(0)
  experienceYears  Int           @default(0)
  reviewCount      Int           @default(0)
  completedJobs    Int           @default(0)
  providerLevel    ProviderLevel @default(BRONZE)
  sector           ProviderSector @default(GENERAL)
  lastComputedAt   DateTime      @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])
}

// Structured cancellation reasons for analytics.
model CancellationReason {
  id        String            @id @default(cuid())
  bookingId String?
  leadId    String?
  actor     CancellationActor
  actorId   String?
  reason    String
  detail    String?
  createdAt DateTime          @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])

  @@index([bookingId])
  @@index([leadId])
  @@index([actor])
  @@index([createdAt])
}

// ============================================================
// Wallet — credits-only. Provider earnings land here on booking
// completion; customers hold referral/promotional/refund credits.
// Withdrawals are provider-only and admin-approved.
// ============================================================

// One wallet per user. balance is always a live sum of the ledger.
model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Float    @default(0)
  totalCredited  Float    @default(0)
  totalDebited   Float    @default(0)
  totalWithdrawn Float    @default(0)
  totalEarned    Float    @default(0)
  currency       String   @default("INR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User                     @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]
  withdrawalRequests WalletWithdrawalRequest[]

  @@index([createdAt])
}

// Immutable ledger of every wallet movement. balanceAfter snapshots the wallet
// balance at the moment the entry was written.
model WalletTransaction {
  id            String                     @id @default(cuid())
  walletId      String
  userId        String
  type          WalletTransactionType
  category      WalletTransactionCategory
  amount        Float
  balanceAfter  Float
  referenceType String?
  referenceId   String?
  description   String?
  status        WalletTransactionStatus   @default(COMPLETED)
  createdAt     DateTime                  @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// Provider payout request. The amount is debited (held) at request time to
// prevent double spending and returned on rejection.
model WalletWithdrawalRequest {
  id             String                  @id @default(cuid())
  walletId       String
  userId         String
  providerId     String
  amount         Float
  status         WithdrawalRequestStatus @default(PENDING)
  accountDetails Json                    @default("{}")
  description    String?
  processedBy    String?
  processedAt    DateTime?
  adminNote      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  wallet   Wallet   @relation(fields: [walletId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([walletId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

// Admin-configurable platform settings (lead timeout, radius, commission, discounts, thresholds...).
model AdminConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

enum ProviderLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum ProviderSector {
  GENERAL
  PREMIUM
}

enum LeadStatus {
  NEW
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  TRANSFERRED
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  FAILED
  CANCELLED
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PlatformFeeRole {
  PROVIDER
  CUSTOMER
}

enum PlatformFeeStatus {
  ACTIVE
  GRACE
  OVERDUE
  DISABLED
}

enum PlatformFeePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CancellationActor {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  COMPLETED
  PENDING
  FAILED
  REVERSED
}

enum WalletTransactionCategory {
  BOOKING_EARNING
  BOOKING_REFUND
  REFERRAL_BONUS
  PROMOTIONAL_CREDIT
  DISPUTE_REFUND
  WITHDRAWAL
  ADJUSTMENT
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ============================================================
// Job queue (durable, PostgreSQL-backed) & async side-effects
// ============================================================

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  priority    Int       @default(0)
  dedupeKey   String?
  availableAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Indexes for the claim query (status + due time) and admin stats.
  @@index([status, availableAt])
  @@index([type, status])
  @@index([dedupeKey])
}

model PlatformDailyStat {
  id                String   @id @default(cuid())
  date              DateTime @unique
  bookingsCreated   Int      @default(0)
  bookingsCompleted Int      @default(0)
  bookingsCancelled Int      @default(0)
  leadsCreated      Int      @default(0)
  leadsAccepted     Int      @default(0)
  revenue           Float    @default(0)
  commission        Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BookingInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  bookingId       String   @unique
  customerId      String?
  providerId      String?
  serviceCategory String?
  amount          Float    @default(0)
  totalAmount     Float    @default(0)
  platformCharge  Float    @default(0)
  providerPayout  Float    @default(0)
  status          String   @default("GENERATED")
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bookingId])
  @@index([issuedAt])
}
