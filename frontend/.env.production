# Production API + realtime endpoints (Vite bakes these into the build).
# Non-secret public URLs — safe to commit. Vercel dashboard variables with the
# same names (Production scope) override these if set.
VITE_API_URL=https://servego-platform.onrender.com/api/v1
VITE_SOCKET_URL=https://servego-platform.onrender.com

# Google Analytics 4 measurement ID for the production site (servego24.com).
# The tag lives in index.html and is injected into every page from this single
# template. Blank in .env, so local/testing builds stay out of this property.
# GA_ID is not a secret, but set it in the Vercel dashboard (Production scope)
# if you ever need to swap properties without a code change.
VITE_GA_ID=G-SL81DC3SSK
