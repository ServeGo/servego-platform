{
  "name": "servego-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.3.0",
    "vite": "^6.4.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run tailwind:build && vite build && node scripts/prerender-seo.js && npm run validate:generated-sitemap",
    "preview": "vite preview --strictPort",
    "validate:seo": "node scripts/validate-seo-output.mjs",
    "validate:sitemap": "node scripts/validate-sitemap-seo.mjs",
    "validate:generated-sitemap": "node scripts/validate-generated-sitemap.mjs",
    "tailwind:build": "tailwindcss -i ./src/index.css -o ./src/tailwind-dist.css --minify"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
